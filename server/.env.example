# PostgreSQL connection for backend
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=travel_db
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Ho_Chi_Minh

# Optional: full DSN overrides DB_* values above
# DATABASE_URL=host=localhost user=postgres password=123456 dbname=travel_db port=5432 sslmode=disable TimeZone=Asia/Ho_Chi_Minh

# JWT and authentication settings
JWT_ISSUER=traveling-backend
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168

# Password and OTP policy
BCRYPT_COST=12
OTP_TTL_SECONDS=180
RESET_TOKEN_TTL_MINUTES=15

# Email/reset flow (use stub locally)
MAIL_PROVIDER=stub
MAIL_FROM=no-reply@traveling.local
RESET_PASSWORD_URL=http://localhost:5173/reset-password

# Email Service Configuration
# Set EMAIL_ENABLED=true to enable real email sending
EMAIL_ENABLED=false

# SMTP Configuration (for Gmail, SendGrid, or custom SMTP)
# For Gmail: smtp.gmail.com:587 with App Password
# For SendGrid: smtp.sendgrid.net:587 with API Key as password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Traveling

# Example for Gmail:
# 1. Enable 2-factor authentication in your Google account
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character app password as SMTP_PASSWORD

# Example for SendGrid:
# 1. Sign up at https://sendgrid.com
# 2. Create API Key with Mail Send permission
# 3. Use 'apikey' as SMTP_USERNAME and your API key as SMTP_PASSWORD

# ============================================================================
# VNPay Payment Gateway Configuration
# ============================================================================
# The system supports two environments: sandbox (testing) and production (live)
# Gateway URLs are automatically selected based on VNPAY_ENVIRONMENT:
#   - Sandbox: https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
#   - Production: https://vnpayment.vn/paymentv2/vpcpay.html
#
# Environment: sandbox (for testing) or production (for live payments)
# Values: sandbox, production (case-insensitive)
VNPAY_ENVIRONMENT=sandbox

# Merchant ID provided by VNPay (also called Terminal Code or TmnCode)
# Different credentials for sandbox vs production
VNPAY_MERCHANT_ID=your-merchant-id

# Secret key for signature generation (keep this secure!)
# Different secret keys for sandbox vs production
VNPAY_SECRET_KEY=your-secret-key

# URL where VNPay redirects the browser after payment.
# This backend endpoint verifies checksum and then redirects to FRONTEND_BASE_URL/payment/result.
# Sandbox: HTTP allowed (e.g., http://localhost:8080/v1/api/payments/return)
# Production: HTTPS required (e.g., https://api.yourdomain.com/v1/api/payments/return)
VNPAY_RETURN_URL=http://localhost:8080/v1/api/payments/return

# URL where VNPay sends payment notifications (backend webhook URL)
# Sandbox: HTTP allowed (e.g., http://localhost:8080/v1/api/payments/webhook)
# Production: HTTPS required (e.g., https://api.yourdomain.com/v1/api/payments/webhook)
VNPAY_IPN_URL=http://localhost:8080/v1/api/payments/webhook

# Frontend app base URL used after ReturnURL verification.
# Production must use HTTPS.
FRONTEND_BASE_URL=http://localhost:5173

# Payment session timeout in minutes (default: 15)
VNPAY_PAYMENT_TIMEOUT=15

# ----------------------------------------------------------------------------
# VNPay Sandbox Setup (for development and testing)
# ----------------------------------------------------------------------------
# 1. Visit https://sandbox.vnpayment.vn/devreg to register
# 2. Complete the registration form
# 3. Receive sandbox credentials:
#    - Merchant ID (TmnCode)
#    - Secret Key (HashSecret)
# 4. Update VNPAY_MERCHANT_ID and VNPAY_SECRET_KEY above
# 5. Use HTTP URLs for local development (HTTPS not required)
# 6. Test with VNPay-provided test cards
#
# Sandbox Configuration Example:
#   VNPAY_ENVIRONMENT=sandbox
#   VNPAY_MERCHANT_ID=your-sandbox-merchant-id
#   VNPAY_SECRET_KEY=your-sandbox-secret-key
#   VNPAY_RETURN_URL=http://localhost:8080/v1/api/payments/return
#   VNPAY_IPN_URL=http://localhost:8080/v1/api/payments/webhook
#   FRONTEND_BASE_URL=http://localhost:5173

# ----------------------------------------------------------------------------
# VNPay Production Setup (for live payments)
# ----------------------------------------------------------------------------
# 1. Contact VNPay sales team to register for production account
# 2. Complete business verification and contract signing
# 3. Provide required business documents
# 4. Pass integration testing in sandbox environment
# 5. Receive production credentials:
#    - Production Merchant ID
#    - Production Secret Key
# 6. Update configuration for production:
#    - Set VNPAY_ENVIRONMENT=production
#    - Update VNPAY_MERCHANT_ID with production merchant ID
#    - Update VNPAY_SECRET_KEY with production secret key
#    - Change VNPAY_RETURN_URL to use HTTPS (required)
#    - Change VNPAY_IPN_URL to use HTTPS (required)
#    - Change FRONTEND_BASE_URL to use HTTPS (required)
# 7. Ensure SSL certificate is valid for your domain
# 8. Configure production monitoring and alerting
#
# Production Configuration Example:
#   VNPAY_ENVIRONMENT=production
#   VNPAY_MERCHANT_ID=your-production-merchant-id
#   VNPAY_SECRET_KEY=your-production-secret-key
#   VNPAY_RETURN_URL=https://api.yourdomain.com/v1/api/payments/return
#   VNPAY_IPN_URL=https://api.yourdomain.com/v1/api/payments/webhook
#   FRONTEND_BASE_URL=https://yourdomain.com

# ----------------------------------------------------------------------------
# Environment Switching
# ----------------------------------------------------------------------------
# To switch between sandbox and production:
# 1. Update VNPAY_ENVIRONMENT (sandbox or production)
# 2. Update VNPAY_MERCHANT_ID (use environment-specific merchant ID)
# 3. Update VNPAY_SECRET_KEY (use environment-specific secret key)
# 4. Update URLs (HTTP for sandbox, HTTPS for production)
# 5. Restart the application
#
# The system will automatically:
# - Select the correct VNPay gateway URL
# - Enforce HTTPS validation in production
# - Validate configuration on startup
#
# Verification:
# - Check logs for "VNPay Environment: sandbox" or "VNPay Environment: production"
# - Check logs for gateway URL to confirm correct environment
